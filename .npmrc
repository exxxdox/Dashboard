# Registry for this project. npm and pnpm both read this file.
#
# https, not http: the plain-http endpoint answers 302 to the https one, so
# plain http would only add a redirect per request and expose the first hop.
#
# Use the tested npm mirror: the previous Tencent endpoint returned HTTP 567.
#
# Docker builds copy this file before installing dependencies.
# NPM_REGISTRY can override the registry for a specific build.
registry=https://registry.npmmirror.com/
