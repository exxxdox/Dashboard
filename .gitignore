node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Runtime state: SQLite database, generated key, local smoke-test scratch.
data/
.smoke/

# Default script checkout directory, used when SCRIPT_ROOT_HOST is left at its
# relative default. It holds cloned repositories, not project source.
/workspace/

.env
.env.*
!.env.example

.DS_Store
Thumbs.db
*.log

# Local agent state and working plans. These describe how the work was done on
# one machine rather than what the project is, so they stay out of the repo.
# Use `git add -f` if a file here is ever meant to be shared.
.claude/
# Personal deployment notes: image tags, host paths, ports. Same reasoning.
CLAUDE.local.md

# The compose file a machine actually runs: its image name, container name and
# mount paths are local, and the port it publishes is the one that machine uses.
# `compose.yaml.example` is the template that is committed -- copy it to
# `compose.yaml` and adjust.
/compose.yaml
