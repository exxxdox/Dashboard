node_modules/
dist/
build/
coverage/
/tmp/
# Server commands can create scratch state relative to their package directory.
/apps/server/tmp/
/docs/
*.tsbuildinfo

# Runtime state: SQLite database, generated key, local smoke-test scratch.
data/
.smoke/

# Keep legacy script checkouts untracked while deployments migrate to data/scripts.
/workspace/

.env
.env.*
!.env.example

.DS_Store
Thumbs.db
*.log

# Local agent state and working plans. These describe how the work was done on
# one machine rather than what the project is, so they stay out of the repo.
# Use `git add -f` if a file here is ever meant to be shared.
.claude/
# Personal deployment notes: image tags, host paths, ports. Same reasoning.
CLAUDE.local.md

# Per-machine compose settings: image name, container name, a port this host
# already uses. Compose merges this over the committed `compose.yaml`
# automatically, so the committed file stays identical to the repository's.
/compose.override.yaml
