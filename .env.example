# Copy to .env and adjust. Every variable below has a working default.
# 复制为 .env 后按需修改；下面每个变量都有可用的默认值。
#
# Keep the file private (`chmod 600 .env`): AUTH_PASSWORD is plain text here.
# 该文件要设为仅属主可读（`chmod 600 .env`）：AUTH_PASSWORD 在这里是明文。
#
# There are no variables for the IPv6 DNS console. Its provider, credentials,
# check interval and Gotify target are rows in the database, edited on the DNS
# page -- a setting never has two sources.
# IPv6 DNS 控制台没有环境变量：服务商、凭据、检查间隔与 Gotify 目标都是数据库里的行，
# 在 DNS 页面编辑 —— 一个设置只允许有一个来源。

# --- Required / 必填 ---

# Host directory holding the scripts, mounted at /workspace to be scanned and read. Absolute, or relative to this file's directory.
# 存放脚本的宿主机目录，挂载到 /workspace 供扫描读取。可写绝对路径，也可相对本文件所在目录。
SCRIPT_ROOT_HOST=./workspace

# --- Ownership and paths / 属主与路径 ---

# uid/gid owning SCRIPT_ROOT_HOST and the data directory (`id -u`, `id -g`); the app runs as this user.
# SCRIPT_ROOT_HOST 与数据目录的属主（用 `id -u`、`id -g` 查）；进程以该用户身份运行。
PUID=1000
PGID=1000

# Host directory holding the database and the generated key, mounted at /data. Keep it local, never a network share.
# 存放数据库与生成的密钥的宿主机目录，挂载到 /data。必须是本机文件系统，不能放网络盘。
DATA_DIR_HOST=./data

# Port the app listens on. Host networking, so this is a port on the machine itself and must be free there.
# 监听端口。用 host 网络，这就是宿主机的端口，必须在本机空闲。
DASHBOARD_PORT=50014

# --- Image build / 镜像构建 ---

# Alpine mirror for the build; host name only (a full URL breaks it), and the mirror must serve alpine under /alpine.
# 构建时用的 Alpine 镜像站；只写主机名（写完整 URL 会导致构建失败），且该站须在 /alpine 下提供 alpine。
#ALPINE_MIRROR=mirrors.cloud.tencent.com

# npm registry for the build; full URL ending in /npm/, and the same host covers both.
# 构建时用的 npm 源；要写以 /npm/ 结尾的完整 URL，同一台主机可同时覆盖上面两项。
#NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/

# Build without git: ~9 MB smaller, but a GitHub source can no longer be synced (local ones still work).
# 构建镜像时不装 git：小约 9 MB，代价是 GitHub 来源无法再同步（local 来源不受影响）。
#WITH_GIT=false

# --- Runtime / 运行时：默认值适用于单机 ---

#LOG_LEVEL=info
#LOG_PRETTY=false

# Scripts running at once globally and on one target; the per-target limit stops one busy host taking every slot.
# 全局与单个目标各自的同时运行数；单目标上限防止一台忙的机器占满全部槽位。
#MAX_CONCURRENT_EXECUTIONS=4
#MAX_CONCURRENT_PER_TARGET=2

# Timeout when neither the script header nor the run request sets one.
# 脚本头部和本次运行请求都没指定超时时使用。
#DEFAULT_TIMEOUT_SEC=1800

# Stored output per run; output past this is still streamed live, but the run is flagged truncated.
# 单次运行存储的输出上限；超出部分仍会实时推送，但该次运行会被标记为已截断。
#MAX_LOG_BYTES=5242880

# Directory on the TARGET HOST that a run stages its script in and deletes again; a small or read-only one breaks runs.
# 目标机上的暂存目录，每次运行的脚本放这里、跑完删除；空间过小或只读会导致运行失败。
#STAGING_DIR=/tmp

# Delete finished runs older than this many days; 0 keeps everything.
# 清理超过该天数的已结束运行；0 表示全部保留。
#RETENTION_DAYS=30

# Proxy for cloning and updating repositories, git transport only (the IPv6 probe never uses one).
# 克隆与更新仓库用的代理，只作用于 git 传输（IPv6 探测不会走代理）。
#GIT_PROXY=http://192.168.1.10:7890

# Key encrypting stored credentials; generated into ./data/secret.key if unset, and losing it loses them all.
# 加密已存凭据用的密钥；不设置会生成到 ./data/secret.key，一旦丢失已存凭据就都解不开。
# Generate with: openssl rand -base64 32
# 生成方式：openssl rand -base64 32
#SECRET_KEY=

# Sign-in credentials: set both or neither, unset runs the dashboard open with a boot warning.
# 登录凭据：两个一起设或都不设；不设则仪表盘开放访问，启动时会有告警。
#AUTH_USERNAME=ops
#AUTH_PASSWORD=change-me-to-something-long
