# 复制为 .env 后按需修改；修改运行配置后需重启，修改构建配置后需重新构建镜像。
# .env 包含明文密码，应设置为仅属主可读（chmod 600 .env）。
# Compose 自动读取该文件；直接运行 Node 服务时，需要通过启动环境传入变量。
# DNS、Gotify 通知和模型中继的配置通过对应页面保存，无需填写环境变量。

# ===== 必须配置 =====
# 启动没有必填项，所有配置均有默认行为。
# 启用登录时，AUTH_USERNAME 和 AUTH_PASSWORD 必须同时设置，见下方登录配置。

# ===== 非必须配置 =====

# --- 登录与凭据 ---

# 登录用户名与密码，必须同时设置或同时省略；省略时允许直接访问仪表盘。
#AUTH_USERNAME=ops
#AUTH_PASSWORD=请替换为自己的长密码

# 已存凭据的加密密钥，格式为 32 字节随机数据的 Base64。
# 省略时自动生成并保存到 DATA_DIR/secret.key；请备份，丢失后需重新录入凭据。
# 可用 openssl rand -base64 32 生成；已有数据时更换密钥会导致原凭据无法解密。
#SECRET_KEY=

# --- Docker Compose 部署 ---

# 容器进程的用户与用户组 ID，默认均为 1000；按宿主机目录属主调整。
#PUID=1000
#PGID=1000

# 宿主机数据目录，默认 ./data，挂载到容器 /data；包含数据库、密钥和脚本。
# SQLite 数据目录须使用本地文件系统。
#DATA_DIR_HOST=./data

# Compose 部署的监听端口，默认 50014；使用宿主机网络，须确保端口空闲。
# Compose 用此值设置容器 PORT。
#DASHBOARD_PORT=50014

# --- 镜像构建 ---

# Alpine 软件源，默认 dl-cdn.alpinelinux.org，无需手动填写。
# 自定义镜像站仅填主机名，且须在 /alpine 路径提供 Alpine 软件仓库。
#ALPINE_MIRROR=mirrors.cloud.tencent.com

# npm 软件源，省略时使用官方源；自定义时填写完整地址。
#NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/

# 是否在镜像中安装 Git，默认 true；设为 false 后无法同步 GitHub 来源。
#WITH_GIT=true

# --- 服务监听与路径 ---

# 服务监听地址，默认 0.0.0.0；仅允许本机访问时可设为 127.0.0.1。
#HOST=0.0.0.0

# 直接运行服务时的监听端口，默认 8080；Compose 部署请使用 DASHBOARD_PORT。
#PORT=8080

# 服务数据目录，默认 /data；直接本地运行时可改为 ./data。
# Compose 部署通常只需设置 DATA_DIR_HOST，保持容器内路径 /data。
#DATA_DIR=/data

# 脚本根目录，默认 DATA_DIR/scripts；仅兼容自定义存储布局时需要覆盖。
#SCRIPT_ROOT_CONTAINER=/data/scripts

# SSH 目标机上的脚本暂存目录，默认 /tmp，须允许 SSH 用户创建和清理暂存文件。
#STAGING_DIR=/tmp

# 是否提供前端静态文件，默认 true；仅启动 API 时可设为 false。
#SERVE_WEB=true

# 前端构建产物目录，代码默认 /app/web，Docker 镜像已设置为 /app/apps/web/dist。
# 直接部署时按实际构建目录设置；使用镜像时通常无需覆盖。
#WEB_DIST_DIR=/app/apps/web/dist

# --- 执行与历史记录 ---

# 全局同时运行数，默认 4，允许 1–64。
#MAX_CONCURRENT_EXECUTIONS=4

# 单个目标同时运行数，默认 2，允许 1–32。
#MAX_CONCURRENT_PER_TARGET=2

# 脚本头部和运行请求均未指定超时时的默认秒数，默认 1800，允许 1–86400。
#DEFAULT_TIMEOUT_SEC=1800

# 单次运行存储的日志上限，默认 5242880 字节（5 MiB），最小 4096。
# 超出部分仍实时推送，但历史日志会标记为截断。
#MAX_LOG_BYTES=5242880

# 已结束运行的保留天数，默认 30，允许 0–3650；0 表示永久保留。
# 定时计划可单独覆盖此策略。
#RETENTION_DAYS=30

# Git 克隆和更新代理，省略时遵循 Git 自身配置及代理环境；IPv6 探测不使用此代理。
#GIT_PROXY=http://192.168.1.10:7890

# --- 运行环境与日志 ---

# 运行环境，默认 production，可选 development、production、test。
#NODE_ENV=production

# 日志级别，默认 info，可选 fatal、error、warn、info、debug、trace。
#LOG_LEVEL=info

# 易读日志，非生产环境默认开启；生产环境强制关闭并使用 JSON 日志。
#LOG_PRETTY=false
