# Copy to .env and adjust. Everything here has a working default except
# SCRIPT_ROOT_HOST, which must be an absolute path on this machine.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Directory on the HOST that holds the scripts, mounted into the container at
# /workspace so they can be scanned and read. It is only how scripts get *in*:
# each target has its own working directory, and the two do not have to match.
SCRIPT_ROOT_HOST=/srv/script-dashboard

# ---------------------------------------------------------------------------
# Ownership
# ---------------------------------------------------------------------------

# uid/gid that owns SCRIPT_ROOT_HOST (find them with `id -u` and `id -g`).
# The dashboard runs as this user so files it clones are usable by both sides.
# The container starts as root only long enough to take ownership of ./data and
# SCRIPT_ROOT_HOST, then drops to this uid before the app starts. Get these
# wrong and the app cannot write its database.
PUID=1000
PGID=1000

# Port to publish the dashboard on.
DASHBOARD_PORT=8080

# Alpine mirror used while building the image. Only set this when the official
# dl-cdn.alpinelinux.org is unreachable from your network, where the build
# otherwise hangs on `apk add` until it times out. Write the host only; the
# mirror has to serve alpine under /alpine. Example:
# ALPINE_MIRROR=mirrors.cloud.tencent.com
#ALPINE_MIRROR=dl-cdn.alpinelinux.org

# npm registry used while building the image. This is the slowest step of a cold
# build on a distant or restricted network. The example below is the same host
# as the Alpine example above, so one mirror covers both. Example for China:
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
#NPM_REGISTRY=https://registry.npmjs.org/

# ---------------------------------------------------------------------------
# Optional -- the defaults are sensible for a single-host setup
# ---------------------------------------------------------------------------

#LOG_LEVEL=info
#LOG_PRETTY=false

# How many scripts may run at once, and how many per target host. The per-target
# limit stops one busy machine from consuming every slot.
#MAX_CONCURRENT_EXECUTIONS=4
#MAX_CONCURRENT_PER_TARGET=2

# Timeout applied when neither the script header nor the run request sets one.
#DEFAULT_TIMEOUT_SEC=1800

# Captured output kept per run. Output beyond this is still streamed live but is
# not stored, and the run is flagged as truncated.
#MAX_LOG_BYTES=5242880

# Directory on the TARGET HOST that each run uploads its script into and deletes
# again. Only the script goes here, never your data. A read-only or very small
# /tmp breaks every run; a noexec one is fine, because scripts are run as
# `bash <file>` rather than executed directly.
#STAGING_DIR=/tmp

# Delete completed runs older than this many days (0 keeps everything).
#RETENTION_DAYS=30

# Proxy used to clone and update repositories, for networks where GitHub is slow
# or unreachable. It must be reachable FROM THE CONTAINER, so "127.0.0.1" here
# means the container itself -- point it at the Docker bridge address (often
# 172.17.0.1) or at a proxy on another host. Both a URL and a bare host:port
# work; socks5h:// is accepted. Only the git transport is affected.
# Example: GIT_PROXY=http://192.168.1.10:7890
#GIT_PROXY=

# Encryption key for stored SSH credentials. Generated into ./data/secret.key
# on first start if unset. Changing or losing it makes existing stored
# credentials undecryptable -- back it up with the database.
# Generate with: openssl rand -base64 32
#SECRET_KEY=

# ---------------------------------------------------------------------------
# Sign-in
#
# Both or neither. Set them and the dashboard asks for these credentials before
# it answers anything; leave them unset and it runs open, as it did before, with
# a warning at boot. There is no registration and no user list -- these two
# values, read at startup, are the whole of it.
#
# Changing the password signs everyone out: the session cookie is signed with a
# key derived from it.
#
# Keep this file readable only by its owner (`chmod 600 .env`): the password is
# in plain text here, which is the price of having no user database.
# ---------------------------------------------------------------------------
# AUTH_USERNAME=ops
# AUTH_PASSWORD=change-me-to-something-long
